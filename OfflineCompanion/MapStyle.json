{
  "version": 8,
  "name": "Offline Companion",
  "glyphs": "file:///MapGlyphs/{fontstack}/{range}.pbf",
  "sources": {
    "land": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "roads": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "cities": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "country-labels": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "route": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          "#deedf5",
          9,
          "#f5f6f8"
        ]
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "land",
      "maxzoom": 9,
      "paint": {
        "fill-color": "#edf1e9"
      }
    },
    {
      "id": "borders",
      "type": "line",
      "source": "land",
      "maxzoom": 8,
      "paint": {
        "line-color": "#b6c0b4",
        "line-width": 0.6
      }
    },
    {
      "id": "waterways",
      "type": "line",
      "source": "roads",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "waterway"
      ],
      "paint": {
        "line-color": "#91c4e8",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          4
        ]
      }
    },
    {
      "id": "road-casing",
      "type": "line",
      "source": "roads",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "kind"
          ],
          "waterway"
        ],
        [
          "!",
          [
            "match",
            [
              "get",
              "kind"
            ],
            [
              "footway",
              "path",
              "steps",
              "cycleway",
              "track"
            ],
            true,
            false
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c5cbd4",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          1.8,
          14,
          7,
          18,
          21
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "roads",
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "kind"
          ],
          "waterway"
        ],
        [
          "!",
          [
            "match",
            [
              "get",
              "kind"
            ],
            [
              "footway",
              "path",
              "steps",
              "cycleway",
              "track"
            ],
            true,
            false
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.8,
          14,
          5,
          18,
          18
        ]
      }
    },
    {
      "id": "trails",
      "type": "line",
      "source": "roads",
      "filter": [
        "match",
        [
          "get",
          "kind"
        ],
        [
          "footway",
          "path",
          "steps",
          "cycleway",
          "track"
        ],
        true,
        false
      ],
      "paint": {
        "line-color": "#a68b64",
        "line-width": 1.8,
        "line-dasharray": [
          2,
          2
        ]
      }
    },
    {
      "id": "country-labels",
      "type": "symbol",
      "source": "country-labels",
      "maxzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 13,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#53635e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "cities",
      "type": "symbol",
      "source": "cities",
      "minzoom": 3,
      "maxzoom": 11,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#455468",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "roads",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "!=",
          [
            "get",
            "kind"
          ],
          "waterway"
        ],
        [
          "!=",
          [
            "get",
            "name"
          ],
          ""
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 12,
        "text-max-angle": 30,
        "text-allow-overlap": false,
        "text-ignore-placement": false
      },
      "paint": {
        "text-color": "#596579",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "route-halo",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": 8
      }
    },
    {
      "id": "route",
      "type": "line",
      "source": "route",
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#2563eb",
        "line-width": 5
      }
    }
  ]
}